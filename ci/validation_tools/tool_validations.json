{
  "__documentation__": {
    "purpose": "Developer-maintained validation rules for generated tool outputs compared to gold-standard files.",
    "how_to_use": [
      "Add one top-level key per tool basename (example: ConvertDOMINO, ConvertEDFbrowser).",
      "Each tool must define a non-empty comparisons array.",
      "Each item in comparisons defines one generated file to compare against one gold-standard file.",
      "If generated and gold names are identical, use fileName only.",
      "fileType: Use 'bag-comparison' for unordered line comparison (order-independent, counts must match), 'generic' for strict line-by-line order preservation, or 'report' for ordered comparison.",
      "fileType 'exists': only checks that the generated file was created and is valid (non-empty; complete PDF for .pdf). No gold standard is needed and the check runs even when gold_standard_tag is empty. Use it for outputs that cannot be compared as text, such as images or PDFs.",
      "comparisons[].delimiter: Optional delimiter override for text normalization when relevant.",
      "comparisons[].maxDiffLines: Optional maximum number of diff lines to print in mismatch logs."
    ],
    "fields": {
      "<ToolName>": "Top-level key for one tool configuration. Must match the JSON filename of the tool in CEAMSTools package.",
      "comparisons": "Array of comparison rules executed for this tool.",
      "comparisons[].fileName": "Preferred single filename used for both generated output and gold-standard reference.",
      "comparisons[].fileType": "Comparison mode used by compare_outputs.py (examples: bag-comparison, generic, report).",
      "comparisons[].generatedSearchRoots": "Ordered list of roots scanned recursively to find generatedFileName.",
      "comparisons[].precision": "Optional integer precision for numeric normalization before comparison. Omit to disable rounding.",
      "comparisons[].delimiter": "Optional delimiter override for text normalization when relevant.",
      "comparisons[].maxDiffLines": "Optional maximum number of diff lines to print in mismatch logs."
    },
    "notes": [
      "Keep generatedSearchRoots as specific and as short as possible.",
      "For stable CI validation, prefer writing outputs under validation-workspaces and private-dataset only.",
      "Unknown top-level keys are ignored by the current workflow as long as tool names are requested explicitly."
    ]
  },
